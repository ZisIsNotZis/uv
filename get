#!/usr/bin/env python3
from asyncio import *
from uvloop import install
from sys import argv
from time import time

N = 0
class Protocol(Protocol):
    def __init__(_, a):
        _._ = a
    def connection_made(_, a):
        a.write(b'GET /' + _._[2].encode() + b' HTTP/1.0\n\n')
    def data_received(_, a):
        global N
        N += len(a)
    def connection_lost(_, a):
        if a:
            print(a)
        Task(get_event_loop().create_connection(lambda:Protocol(_._), *_._[:2]))

async def main():
    global N
    for t in range(1, len(argv), 4):
        for _ in range(int(argv[t+3])):
            try:
                await get_event_loop().create_connection(lambda t=t:Protocol(argv[t:t+3]), *argv[t:t+2])
            except:
                break
        else:
            continue
        break
    while True:
        t = time()
        await sleep(3)
        print((N >> 20) / (time() - t))
        N = 0

install()
new_event_loop().run_until_complete(main())
